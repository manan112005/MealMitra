# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mealmitra?schema=public"

# Security & Authentication
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-minimum-32-characters"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-minimum-32-characters"

# Frontend Integration
FRONTEND_URL="http://localhost:5714"
ALLOWED_ORIGINS="http://localhost:5714,http://localhost:5173,http://localhost:3000"
